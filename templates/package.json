{
  "name": "gasboost-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "build:client": "vite build --mode client",
    "build:server": "vite build --mode server",
    "build:manifest": "cp appsscript.json dist/appsscript.json",
    "build": "pnpm clean && pnpm build:client && pnpm build:server && pnpm build:manifest",
    "push": "pnpm build && pnpm clasp push --force",
    "deploy:new": "pnpm clasp login && pnpm push && pnpm clasp create-deployment",
    "deploy:update": "pnpm push && pnpm clasp update-deployment AKfycbwvtof5SHJSO0EDcGZcdqQFZ9_yeqsUM9SCgHQ9SSlNEnUscmo-yZOB0-yt9F3UAO4n1Q"
  },
  "dependencies": {
    "@gasboost/app": "latest",
    "@gasboost/auth": "latest",
    "@gasboost/auth-app": "latest",
    "@gasboost/auth-realtime-firebase": "^0.1.1",
    "@gasboost/auth-sheetorm": "latest",
    "@gasboost/client": "latest",
    "@gasboost/react": "latest",
    "@gasboost/replica": "^0.2.0",
    "@gasboost/rls": "^0.3.0",
    "@gasboost/sheetorm": "latest",
    "@gasboost/table": "^0.1.0",
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@gasboost/cli": "^0.3.0",
    "@gasboost/console": "^0.1.0",
    "@gasboost/fake-core": "latest",
    "@gasboost/fake-node": "latest",
    "@gasboost/vite": "latest",
    "@types/google-apps-script": "^2.0.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clasp": "^1.0.0",
    "firebase-tools": "^15.30.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
